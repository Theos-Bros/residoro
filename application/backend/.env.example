# Optional -- itinerary generation (Google Docs/Drive) degrades gracefully to a clear
# "not configured yet" error if unset, rather than crashing the app. On Render, supply this
# via a Secret File (a JSON key file written to disk at deploy time) so this stays a real
# file path; see cap-deployment-001 / tb-deployment-backend-fixes-001 for the decision record.
GOOGLE_APPLICATION_CREDENTIALS=
