# "Rdoro Demo" Supabase project — safe to commit, it's just the project's public URL.
VITE_SUPABASE_URL=https://ngizypfgpynsvijiopji.supabase.co

# The anon/publishable key is safe to expose client-side by design, but get the
# real value from the Supabase dashboard (Project Settings > API) rather than
# hardcoding it here, so key rotation doesn't require a source change.
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
